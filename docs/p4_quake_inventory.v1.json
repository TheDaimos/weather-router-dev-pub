  "mapping_gaps_for_p4_quake_20": [
    {
      "id": "significant_upstream_semantics",
      "finding": "WeatherRouter consumes USGS significant_month but encodes no fixed significance/magnitude rule.",
      "decision_needed": "Define only the semantics that can be supported without inventing a threshold."
    },
    {
      "id": "magnitude_severity_display_band",
      "finding": "Generic severity is currently derived from magnitude bands and explicitly labelled a WeatherRouter display band.",
      "decision_needed": "Decide how to preserve magnitude without conflating it with intensity, damage or official hazard severity."
    },
    {
      "id": "point_context_filtering",
      "finding": "USGS earthquake adapters ignore point arguments; BBOX filtering exists provider-side, but no generic quake point geometry filter is applied centrally.",
      "decision_needed": "Define intended Point semantics and truthful diagnostics/coverage behavior."
    },
    {
      "id": "typed_earthquake_semantics",
      "finding": "Magnitude, depth, felt, CDI, MMI, PAGER alert, significance and tsunami flag live in generic parameters.",
      "decision_needed": "Assess whether additive typed earthquake semantics are useful; do not pre-decide in inventory."
    },
    {
      "id": "routing_diagnostic_visibility",
      "finding": "Routing diagnostics expose generic hazard summaries but not quake-specific magnitude/depth/intensity/significance fields.",
      "decision_needed": "Define which fields should become diagnostic summaries, if any."
    },
    {
      "id": "non_earthquake_topic_assignment",
      "finding": "The non-earthquake seismic capability is correctly public-separated but its topic assignment includes both earthquake and seismic_activity.",
      "decision_needed": "Review topic wording without merging the public contracts."
    },
    {
      "id": "cross_feed_overlap",
      "finding": "USGS all-day and significant-month can overlap; GDACS EQ can overlap specialized observations.",
      "decision_needed": "Inventory overlap only; no deduplication or provider priority before semantics/design."
    },
    {
      "id": "update_time_mapping",
      "finding": "USGS earthquake updated timestamp is mapped to sent but is not separately exposed as a named update parameter.",
      "decision_needed": "Review time semantics in P4-QUAKE-20."
    }
  ],
  "invariants": [
    "P4-QUAKE-10 is inventory only and changes no runtime behavior.",
    "No new public capability is introduced.",
    "USGS significant does not imply a WeatherRouter-defined fixed magnitude threshold.",
    "WeatherRouter magnitude severity bands are display bands, not intensity, damage or official warning levels.",
    "Earthquake is not automatically tsunami.",
    "USGS tsunami_flag is metadata and not an official tsunami warning.",
    "GDACS earthquake remains disaster awareness and is not an interchangeable primary observation.",
    "USGS non-earthquake seismic remains separate from earthquake.",
    "Endpoint reachability is not coverage proof.",
    "Provider ID is not a scoring axis.",
    "Profiles remain deny-only.",
    "No cross-provider or cross-feed deduplication is introduced in P4-QUAKE-10."
  ],
