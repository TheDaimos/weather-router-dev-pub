  "invariants": [
    "total cloud cover != low cloud cover != mid cloud cover != high cloud cover",
    "station observation != model forecast by default",
    "unknown or runtime-only unit does not prove percent equivalence",
    "numeric point value != raster satellite imagery",
    "true color != GeoColor != clean infrared != visible red != air mass by default",
    "daylight-dependent visible imagery remains distinguishable from day/night products",
    "different frame cadence remains part of product semantics",
    "provider id is not a quality or scoring axis",
    "unknown coverage remains unknown",
    "endpoint reachability is not coverage evidence",
    "existing specialized public capabilities remain preserved"
  ],
  "decisions_for_p2_cloud_30": [
    "Decide whether the four model total-cloud-cover candidates should harden the existing weather.point.cloud_cover public id as a forecast-only shared intent.",
    "Decide how ECCC station cloud_cover should remain accessible without silently mixing an observation of unknown static unit into a forecast-percent intent.",
    "Keep total, low, mid and high cloud-cover quantities separate and refine normalized quantities before implementation.",
    "Decide whether weather.satellite.clouds should be formalized as a generic visual cloud-layer intent for DWD and EUMETView with candidate-specific product metadata.",
    "Keep True Color, GeoColor, Clean Infrared, Visible Red and Air Mass specialized unless an explicit product-class contract justifies grouping.",
    "Decide whether cloud-relevant specialized NASA satellite public capabilities should receive phenomena=[clouds] additively without changing their specialized ids.",
    "Preserve candidate-specific cadence, daylight constraints and machine-readable coverage in any satellite-layer design."
  ]
}
