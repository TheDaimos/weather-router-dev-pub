      "resource_type": "value",
      "numeric_interchangeable": true,
      "sky_condition_policy": "clear_sky",
      "temporal_policy": "current_or_near_current_forecast",
      "unit_policy": "dimensionless_one",
      "canonical_unit": "1",
      "quantity_policy": "uv_index",
      "observation_kind_policy": "forecast",
      "coverage": "candidate_specific_unknown_allowed",
      "fallback_policy": "sequential_declared_candidates_only"
    },
    "weather.point.uv_index_max_today": {
      "semantic_class": "uv_index_all_sky_daily_max_forecast_point",
      "candidates": [
        "open_meteo/uv_index_max_today"
