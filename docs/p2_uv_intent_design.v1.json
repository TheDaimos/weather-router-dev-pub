      "resource_type": "value",
      "numeric_interchangeable": true,
      "sky_condition_policy": "all_sky_or_cloud_affected",
      "temporal_policy": "maximum_for_local_day_today",
      "unit_policy": "dimensionless_one",
      "canonical_unit": "1",
      "quantity_policy": "uv_index",
      "observation_kind_policy": "forecast",
      "coverage": "candidate_specific_unknown_allowed",
      "fallback_policy": "only_declared_candidates"
    },
    "weather.point.uv_index_clear_sky_max_today": {
      "semantic_class": "uv_index_clear_sky_daily_max_forecast_point",
      "candidates": [
        "open_meteo/uv_index_clear_sky_max_today"
      ],
      "resource_type": "value",
      "numeric_interchangeable": true,
      "sky_condition_policy": "clear_sky",
      "temporal_policy": "maximum_for_local_day_today",
      "unit_policy": "dimensionless_one",
      "canonical_unit": "1",
      "quantity_policy": "uv_index",
      "observation_kind_policy": "forecast",
      "coverage": "candidate_specific_unknown_allowed",
      "fallback_policy": "only_declared_candidates"
