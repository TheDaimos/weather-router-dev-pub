{
  "schema": "weather_router.p3_hail_intent_design.v1",
  "date": "2026-10-04",
  "status": "design_only",
  "public_capability_count_before": 226,
  "public_capability_count_after": 226,
  "public_capabilities_added": 0,
  "public_transport": {
    "id": "weather.warning.official",
    "strategy": "aggregate",
    "resource_type": "hazard_feed",
    "candidates": [
      "dwd/official_weather_warnings",
      "noaa_nws/official_weather_alerts"
    ]
  },
  "primary_hazard_type": {
    "change": false,
    "reorder_patterns": false,
    "reason": "preserve existing stable primary classification"
  },
  "additive_event_fields": {
    "hail_semantic_class": {
      "values": [
        "official_hail_alert_event"
      ],
      "independent_of_primary_hazard_type": true
    },
    "hail_match_scope": {
      "values": [
        "explicit_event",
        "contextual_text"
      ],
      "explicit_fields": [
        "event",
        "headline"
      ],
      "contextual_fields": [
        "description",
        "instruction"
      ],
      "explicit_precedence": true
    },
    "alert_stage": {
      "reuse_existing_field": true,
      "values": [
        "warning",
        "watch",
        "outlook",
        "statement",
        "unspecified"
      ]
    }
  },
  "provider_rules": {
    "dwd": {
      "real_hail_evidence_required": true,
      "hail_alert_stage": "warning"
    },
    "noaa_nws": {
      "real_hail_evidence_required": true,
      "alert_stage_normalizer": "normalize_alert_stage(event, headline)"
    }
  },
  "event_filter_additions": {
    "hail_semantic_classes": [
      "official_hail_alert_event"
    ],
    "hail_match_scopes": [
      "explicit_event",
      "contextual_text"
    ],
    "reuse_alert_stages": true,
    "specialized_hail_filter_does_not_require_hazard_type_hail": true
  },
  "preservation": {
    "consumer_normalization_fields": [
      "hail_semantic_class",
      "hail_match_scope",
      "alert_stage"
    ],
    "resource_diagnostic_fields": [
      "hail_semantic_classes",
      "hail_match_scopes",
      "alert_stages"
    ]
  },
  "excluded": [
    "observed_or_reported_hail_event",
    "hail_size_measurement_or_forecast",
    "radar_hail_signature",
    "hail_probability_forecast",
    "new_hail_public_capability",
    "provider_priority",
    "cross_provider_deduplication",
    "coverage_semantics_change",
    "primary_hazard_pattern_reordering"
  ],
  "invariants": [
    "No new hail public capability.",
    "weather.warning.official remains aggregate with DWD and NOAA/NWS.",
    "Primary hazard_type normalization remains unchanged.",
    "Hail semantics are additive and independent of the primary hazard label.",
    "Explicit and contextual hail evidence remain distinguishable.",
    "Existing alert_stage is reused.",
    "Official hail alert is not observed hail.",
    "Severity is not hail size.",
    "Radar hail signature is not observed hail.",
    "Hail probability is not official warning.",
    "Provider ID is not a scoring axis.",
    "Profiles remain deny-only.",
    "Coverage unknown remains unknown.",
    "Endpoint reachability is not coverage proof.",
    "Private extensions remain outside the standard core contract."
  ]
}
