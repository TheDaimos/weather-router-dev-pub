{
  "schema": "weather_router.p2_wind_semantics.v1",
  "date": "2026-10-02",
  "scope": "P2-WIND-20 semantics only; no intent implementation or scoring changes",
  "semantic_families": {
    "wind_speed_point": {
      "resource_type": "value",
      "semantic_quantity": "wind_speed",
      "expected_height_m": 10,
      "numeric": true,
      "unit_dimension": "speed",
      "canonical_unit_for_future_routing": "m/s",
      "compatible_units": [
        "m/s",
        "km/h"
      ],
      "unit_conversion_required": true,
      "observation_classes": [
        "forecast",
        "nowcast"
      ],
      "notes": [
        "Forecast and nowcast remain distinct observation classes even when the physical quantity matches.",
        "A shared future intent may only mix them if its contract explicitly permits both classes."
      ]
    },
    "wind_gust_point": {
      "resource_type": "value",
      "semantic_quantity": "wind_gust_speed",
      "expected_height_m": 10,
      "numeric": true,
      "unit_dimension": "speed",
      "canonical_unit_for_future_routing": "m/s",
      "compatible_units": [
        "m/s",
        "km/h"
      ],
      "unit_conversion_required": true,
      "statistic": "gust/max over provider-defined period",
      "notes": [
        "Not interchangeable with mean/instant wind speed.",
        "Current P1 normalized quantity=wind_speed is too coarse to express gust statistic and should be refined before shared numeric routing."
      ]
    },
    "wind_direction_point": {
      "resource_type": "value",
      "semantic_quantity": "wind_from_direction",
      "numeric": true,
      "unit_dimension": "angle",
      "canonical_unit_for_future_routing": "degree",
      "compatible_units": [
        "°"
      ],
      "convention": "meteorological from-direction where provider contract supports it",
      "notes": [
        "Model/forecast directions can form one semantic candidate class after convention verification.",
        "ECCC station direction at maximum wind over a lookback period is a separate observational statistic."
      ]
    },
    "wind_layer": {
      "resource_type": "raster_tile",
      "semantic_quantity": "wind_speed_field",
      "numeric_semantics_exposed_by_provider": "m/s",
      "observation_kind": "forecast",
      "data_origin": "model",
      "notes": [
        "Resource-incompatible with point values.",
        "Current inventory has only DWD icon_wind_10m, so there is no multi-provider raster interchangeability to decide yet."
      ]
    },
    "wind_summary_text": {
      "resource_type": "value",
      "semantic_quantity": null,
      "numeric": false,
      "notes": [
        "JMA wind_summary is textual and not numerically interchangeable with speed, gust or direction."
      ]
    },
    "wind_hazard_products": {
      "resource_type": "hazard_feed",
      "numeric": false,
      "notes": [
        "Warnings/events are separate hazard semantics and excluded from meteorological wind-value routing."
      ]
    }
  },
