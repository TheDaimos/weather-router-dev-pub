  "invariants": [
    "wind_gust_speed != generic wind_speed",
    "raster_tile != point value",
    "text summary != numeric value",
    "station observation != model forecast by default",
    "nowcast != forecast by default",
    "unit convertibility does not imply semantic interchangeability",
    "provider id is not a quality or scoring axis",
    "unknown coverage remains unknown",
    "hazard feeds remain separate"
  ],
  "decisions_for_p2_wind_30": [
    "Design separate provider-neutral numeric intents for speed, gust and direction if needed.",
    "Decide whether forecast-only and nowcast-inclusive contracts should be separate intents or explicit observation-kind variants.",
    "Do not create a shared raster intent with only one current raster candidate unless the abstraction still provides consumer value.",
    "Keep JMA wind_summary and ECCC specialized observational direction outside generic numeric routing unless a precise contract is designed.",
    "Require explicit unit normalization before numeric shared routing.",
    "Refine gust physical semantics from quantity=wind_speed to an explicit gust statistic before implementation."
  ]
