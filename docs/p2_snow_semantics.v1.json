{
  "schema": "weather_router.p2_snow_semantics.v1",
  "date": "2026-10-03",
  "scope": "P2-SNOW-20 semantics only; no intent implementation, provider expansion or scoring changes",
  "semantic_families": {
    "snowfall_amount_recent_interval_forecast_point": {
      "resource_type": "value",
      "semantic_quantity": "snowfall_amount",
      "numeric": true,
      "canonical_unit_for_future_routing": "cm",
      "observation_kind": "forecast",
      "data_origin": "model",
      "accumulation_semantics": "preceding_runtime_interval_sum",
      "runtime_interval_source": "provider current.interval",
      "candidates": [
        "open_meteo/snowfall"
      ],
      "notes": [
        "Open-Meteo documents snowfall as an amount, not snow depth on the ground.",
        "WeatherRouter currently requests the Open-Meteo current field; current conditions are based on short-interval model data and the provider response exposes current.interval.",
        "The routing contract must therefore preserve an interval/accumulation meaning instead of not_applicable.",
        "Only one direct candidate exists, so no provider fallback or interchangeability claim exists yet."
      ]
    },
    "weather_condition_code_forecast": {
      "resource_type": "value",
      "semantic_quantity": "not_applicable",
      "numeric": false,
      "canonical_unit_for_future_routing": null,
      "observation_kind": "forecast",
      "candidates": [
        "open_meteo/weather_code",
        "smhi/weather_code",
        "jma/weather_code"
      ],
      "notes": [
        "Weather-condition codes may encode snow, freezing rain or other winter conditions.",
        "They are categorical state descriptions and are not snowfall_amount."
      ]
    },
    "weather_condition_summary_forecast": {
      "resource_type": "value",
      "semantic_quantity": "not_applicable",
      "numeric": false,
      "canonical_unit_for_future_routing": null,
      "observation_kind": "forecast",
      "candidates": [
        "noaa_nws/weather_summary",
        "jma/weather_summary"
      ],
      "notes": [
        "Text/summary forecasts may describe snow or ice.",
        "They do not provide a numeric snowfall_amount."
      ]
    },
    "official_weather_warning_event": {
      "resource_type": "hazard_feed",
      "semantic_quantity": "not_applicable",
      "numeric": false,
      "canonical_unit_for_future_routing": null,
      "observation_kind": "warning_event",
      "candidates": [
        "dwd/official_weather_warnings",
        "noaa_nws/official_weather_alerts"
      ],
      "notes": [
        "Winter-weather warnings are event/warning semantics, not point snowfall values.",
        "Dynamic event geometry is a different coverage model from point-data coverage."
      ]
    },
    "biodiversity_false_positive": {
      "resource_type": "raster_tile",
      "semantic_quantity": "occurrence_density",
      "numeric": true,
      "canonical_unit_for_future_routing": "provider_capability",
      "observation_kind": "observation",
      "candidates": [
        "gbif_biodiversity/occurrence_density_snow_leopard"
      ],
      "notes": [
        "The lexical token snow in snow_leopard must not classify biodiversity occurrence density as meteorological snow/ice.",
        "This candidate remains biological_hazards only for meteorological routing purposes."
      ]
    }
  },
