{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeatherRouter active Consumer API V2 raster mosaic response (P7-010)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "capability",
    "status",
    "viewport",
    "layers"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "capability": {
      "const": "weather.precipitation.layer"
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "unavailable"
      ]
    },
    "viewport": {
      "$ref": "#/$defs/bbox"
    },
    "reference_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "layers": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "uncovered_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bbox"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layer_order": {
      "type": "string",
      "enum": [
        "background_to_foreground"
      ],
      "description": "The ordered layers array is drawn bottom-to-top; the final entry is visually on top."
    },
    "source_outcomes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "result"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 128
          },
          "result": {
            "type": "string",
            "maxLength": 72
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "properties": {
        "west": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "south": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "resource_type",
        "coverage",
        "tile_url",
        "semantics",
        "times",
        "attribution",
        "legend",
        "coverage_verified",
        "coverage_scope",
        "render"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_type": {
          "const": "raster_tile"
        },
        "coverage": {
          "$ref": "#/$defs/bbox"
        },
        "tile_url": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "unit",
            "measurement_method",
            "observation_kind"
          ],
          "properties": {
            "quantity": {
              "type": "string"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "description": "Unknown/undefined numerical units must remain null, not fabricated."
            },
            "measurement_method": {
              "type": "string"
            },
            "observation_kind": {
              "type": "string"
            }
          }
        },
        "times": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid_at",
            "retrieved_at"
          ],
          "properties": {
            "valid_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "reference_delta_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "age_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "legend": {
          "type": "object",
          "additionalProperties": true
        },
        "quality_note": {
          "type": "string"
        },
        "mask": {
          "type": "object",
          "description": "Optional validated geometric clipping mask; source and shape must be explicitly documented"
        },
        "coverage_verified": {
          "const": true,
          "description": "Verified machine-readable geographic envelope; not proof of every pixel"
        },
        "coverage_scope": {
          "enum": [
            "global",
            "bbox"
          ]
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tile_size",
            "min_zoom",
            "max_zoom",
            "opacity"
          ],
          "properties": {
            "tile_size": {
              "type": "integer",
              "enum": [
                128,
                256,
                512
              ]
            },
            "min_zoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "max_zoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "freshness_class": {
          "type": "string",
          "enum": [
            "current",
            "older_background"
          ]
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draw_order",
            "role",
            "routing_score"
          ],
          "properties": {
            "draw_order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "role": {
              "type": "string",
              "enum": [
                "background",
                "overlay"
              ]
            },
            "routing_score": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
