{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-router.local/contracts/diagnostics/routing_diagnostics.request.schema.json",
  "title": "WeatherRouter Routing Diagnostics Query Request",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "weather_router/routing_diagnostics"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
