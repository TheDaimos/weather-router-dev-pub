{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather_router.consumer.resource.event_feed.v1",
  "title": "WeatherRouter Event Feed Resource V1",
  "type": "object",
  "required": [
    "events",
    "event_count"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "event_type",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "distance_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "azimuth_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 360
          },
          "source_distance_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "source_azimuth_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 360
          },
          "status": {},
          "region": {},
          "source_semantics": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "window_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
