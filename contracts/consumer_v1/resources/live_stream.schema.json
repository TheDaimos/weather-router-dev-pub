{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather_router.consumer.resource.live_stream.v1",
  "title": "WeatherRouter Live Stream Resource V1",
  "type": "object",
  "required": [
    "url",
    "transport"
  ],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "enum": [
        "direct",
        "weather_router_proxy"
      ]
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
