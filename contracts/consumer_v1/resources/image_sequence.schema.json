{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather_router.consumer.resource.image_sequence.v1",
  "title": "WeatherRouter Image Sequence Resource V1",
  "type": "object",
  "required": [
    "frames",
    "georeferenced"
  ],
  "properties": {
    "georeferenced": {
      "type": "boolean"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "url"
        ],
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "extent": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "west",
              "south",
              "east",
              "north"
            ],
            "properties": {
              "west": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "south": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "east": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "north": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "default_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "loop": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
