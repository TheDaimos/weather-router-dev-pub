{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather_router.consumer.resource.data_file.v1",
  "title": "WeatherRouter Data File Resource V1",
  "type": "object",
  "required": [
    "format",
    "url",
    "transport"
  ],
  "properties": {
    "format": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "enum": [
        "direct",
        "weather_router_proxy"
      ]
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "data_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
