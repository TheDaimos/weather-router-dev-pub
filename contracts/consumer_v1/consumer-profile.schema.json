{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather_router.consumer.profile.v1",
  "title": "WeatherRouter Consumer Profile V1",
  "type": "object",
  "required": [
    "id",
    "name",
    "enabled",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "enabled": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "weather",
          "natural_hazards",
          "civil_protection",
          "security",
          "aviation",
          "space",
          "pollen",
          "biological_hazards"
        ]
      }
    },
    "allowed_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_phenomena": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
      }
    },
    "allowed_hazard_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_severities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "unknown",
          "minor",
          "moderate",
          "severe",
          "extreme"
        ]
      }
    },
    "excluded_providers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
